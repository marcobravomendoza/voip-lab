# Copy this file to .env and adjust the values:  cp .env.example .env
# .env is git-ignored. Never commit real passwords.
# Only variables prefixed with LAB_ are substituted into Asterisk *.tmpl files.

# --- Build ---
# Asterisk version built from source (downloads.asterisk.org). 22.x is the current LTS.
LAB_ASTERISK_VERSION=22.11.0

# --- Network ---
# LAN IP of the Docker host. Softphones send SIP/RTP here, and Asterisk
# advertises it in Contact/Via/SDP because it sits behind Docker NAT.
LAB_HOST_IP=192.168.1.100

# --- Time zone ---
# Used for log timestamps and CDRs (IANA name, e.g. Europe/Madrid, UTC).
LAB_TZ=Europe/Madrid

# --- SIP extension passwords (digest auth) ---
LAB_EXT_1001_PASSWORD=change-me-1001
LAB_EXT_1002_PASSWORD=change-me-1002
LAB_EXT_1003_PASSWORD=change-me-1003
